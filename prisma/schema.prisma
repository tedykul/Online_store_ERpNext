// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // NextAuth (Plan B) — admin authentication fields
  passwordHash String?
  role         String   @default("viewer")
  active       Boolean  @default(true)
  lastLoginAt  DateTime?

  auditLogs AdminAuditLog[]
  sessions  Session[]
}

// ============================================================
// Session — opaque-token server sessions for admin auth.
// ============================================================
// Replaces the legacy "Bearer password" scheme. Login route
// mints a random 32-byte token, stores it here, and sets it as
// an httpOnly cookie. verifyAuth() reads the cookie → looks up
// the row → returns the real User (id, email, role).
//
// userId is nullable to support the legacy password-gate mode
// (anonymous admin session when no User row is linked). Real
// logins always attach a userId.
// ============================================================

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Snapshot of email for display/audit when userId is null (password-gate).
  email     String?
  /// Snapshot of role at session-create time. One of:
  /// super_admin | admin | staff | viewer | password_gate
  role      String   @default("viewer")
  /// "nextauth" (real user login) | "password_gate" (legacy fallback)
  method    String   @default("nextauth")
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Messages submitted via the public contact form (Section Kontak).
/// Persisted for admin follow-up; safe to prune old entries periodically.
model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  /// Status of admin follow-up: pending | replied | archived
  status    String   @default("pending")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

/// Email subscribers from the footer newsletter signup form.
/// Unique email constraint prevents duplicates.
model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  /// Status: active | unsubscribed
  status    String   @default("active")
  /// Source of subscription: footer | promo | manual
  source    String   @default("footer")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

// ============================================================
// Admin-editable content models
// ============================================================
// SiteSetting: singleton row holding key-value content for Hero,
// Promo, Contact, About, Footer sections. Fallback to hardcoded
// defaults if row missing or field null (backward compat).
// ============================================================

/// Singleton row (id='singleton') holding editable site content.
/// All fields optional — null means use hardcoded default.
model SiteSetting {
  id    String  @id @default("singleton")

  // Hero section
  heroBadge        String? // "Dipetik pagi, sampai rumah siang"
  heroTitleA       String? // "Sayur & Buah"
  heroTitleHighlight String? // "Segar Harian"
  heroTitleB       String? // "dari Petani Lokal"
  heroSubtitle     String?
  heroCtaPrimary   String? // "Mulai Belanja"
  heroCtaSecondary String? // "Lihat Promo"

  // Promo banner
  promoId          String? // unique campaign id (changing resets dismiss)
  promoTitle       String?
  promoDescription String?

  // Contact section
  contactPhone     String?
  contactEmail     String?
  contactAddress   String?
  contactHours     String?

  // About section
  aboutBadge       String?
  aboutTitleA      String?
  aboutTitleHighlight String?
  aboutTitleB      String?
  aboutSubtitle    String?
  aboutStoryH3     String?
  aboutStoryP1     String?
  aboutStoryP2     String?
  aboutStat1Value  String?
  aboutStat1Label  String?
  aboutStat2Value  String?
  aboutStat2Label  String?
  aboutStat3Value  String?
  aboutStat3Label  String?
  aboutStat4Value  String?
  aboutStat4Label  String?
  aboutValue1Title String?
  aboutValue1Desc  String?
  aboutValue2Title String?
  aboutValue2Desc  String?
  aboutValue3Title String?
  aboutValue3Desc  String?
  aboutValue4Title String?
  aboutValue4Desc  String?

  // Footer
  footerBrandText  String?
  footerTagline    String?

  // Branding (Sprint 11 — Branding Lite)
  brandName        String? // "SayurBox" — used in header, footer, metadata
  metaDescription  String? // SEO meta description
  socialInstagram  String? // URL or null
  socialFacebook   String?
  socialTwitter    String?
  socialTiktok     String?
  socialWhatsapp   String? // wa.me link

  // Sprints 12-24 — favicon, shipping, reward, about image, testimonial,
  // top bar, footer copyright.
  faviconUrl              String?
  freeShippingThreshold   Int?
  shippingFee             Int?
  rewardOrderCount        Int?
  rewardDiscountPercent   Int?
  aboutImage              String?
  testimonialBadge        String?
  testimonialTitleA       String?
  testimonialTitleHighlight String?
  testimonialTitleB       String?
  testimonialSubtitle     String?
  testimonialStat1Value   String?
  testimonialStat1Label   String?
  testimonialStat1Subtext String?
  testimonialStat2Value   String?
  testimonialStat2Label   String?
  testimonialStat2Subtext String?
  testimonialStat3Value   String?
  testimonialStat3Label   String?
  testimonialStat3Subtext String?
  testimonialStat4Value   String?
  testimonialStat4Label   String?
  testimonialStat4Subtext String?
  topBarShipping          String?
  topBarBadge             String?
  footerCopyrightText     String?

  updatedAt DateTime @updatedAt
}

/// FAQ items — orderable, publishable.
model FAQ {
  id        String  @id @default(cuid())
  question  String
  answer    String
  order     Int     @default(0)
  published Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published])
  @@index([order])
}

/// Testimonials — orderable, publishable.
model Testimonial {
  id        String  @id @default(cuid())
  name      String
  role      String
  avatar    String  // emoji
  rating    Float   // 0-5
  text      String
  location  String
  order     Int     @default(0)
  published Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published])
  @@index([order])
}

/// Categories (Item Group display) — editable emoji, name, description.
/// Kept separate from ERPNext Item Group to allow custom display config.
model CategorySetting {
  id          String  @id @default(cuid())
  name        String  @unique // matches Product.category
  emoji       String
  description String?
  gradient    String  // tailwind gradient classes
  order       Int     @default(0)
  published   Boolean @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published])
  @@index([order])
}

// ============================================================
// Audit log — track all admin actions for accountability.
// ============================================================
// Sprint 6 (Skenario C): logs IP + timestamp + action (no user
// tracking since password gate is shared). When upgraded to NextAuth
// (Plan B), add userId field for user-specific tracking.
// ============================================================

/// Audit log entries for all admin API actions.
model AdminAuditLog {
  id        String   @id @default(cuid())
  action    String
  target    String
  ip        String?
  userAgent String?
  success   Boolean  @default(true)
  detail    String?
  createdAt DateTime @default(now())

  // NextAuth — user tracking fields (nullable for backward compat)
  userId    String?
  userEmail String?

  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([action])
  @@index([ip])
  @@index([userId])
}

// ============================================================
// Orders — customer orders for tracking + admin management.
// ============================================================
// Order: header record (1 per checkout). itemsJson: line items as
// JSON string (avoids separate table for simplicity).
// trackingId: customer-facing ID (6-char uppercase alphanumeric,
//   easy to share via WhatsApp).
// status: pending → confirmed → preparing → out_for_delivery →
//   delivered (or cancelled). Admin updates via dashboard.
// erpSalesOrderName: link to ERPNext Sales Order (null in mock mode).
// ============================================================

model Order {
  id              String   @id @default(cuid())
  /// Customer-facing tracking ID (6-char uppercase alphanumeric)
  trackingId      String   @unique
  /// Customer info (snapshot at order time)
  customerName    String
  customerEmail   String?
  customerPhone   String
  customerAddress String
  customerCity    String?
  customerNotes   String?
  /// Order details (JSON string of items array)
  itemsJson       String
  subtotal        Int      // in IDR
  shipping        Int      // in IDR
  total           Int      // in IDR
  /// Discount applied (reward / promo / coupon) in IDR. Defaults to 0.
  discount        Int      @default(0)
  /// Coupon code applied (snapshot). Null = no coupon used.
  couponCode      String?
  deliveryMethod  String   // "delivery" | "pickup"
  paymentMethod   String   // "cod" | "transfer" | "ewallet"
  /// Status workflow: pending → confirmed → preparing →
  /// out_for_delivery → delivered | cancelled
  status          String   @default("pending")
  /// Link to ERPNext Sales Order (null in mock mode)
  erpSalesOrderName String?
  /// Estimated delivery time (ISO string)
  estimatedDelivery String?
  /// JSON array of {status, timestamp} for history tracking
  statusHistoryJson String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([trackingId])
  @@index([status])
  @@index([createdAt])
  @@index([customerPhone])
  @@index([customerEmail])
  @@index([couponCode])
}

// ============================================================
// OrderReview — customer review per order (grocery model).
// ============================================================
// One review per order (orderId unique). Customer can submit
// only after order status = "delivered". Moderated by admin
// before publishing to the storefront (status: pending →
// published | rejected).
//
// Sub-ratings (1-5, optional) are grocery-specific:
//   freshnessRating — quality of produce
//   deliveryRating   — speed + condition on arrival
//   packingRating    — packaging quality
//
// adminReply (optional) — admin response shown alongside the
// review on the storefront.
// ============================================================

model OrderReview {
  id              String   @id @default(cuid())
  /// One review per order. orderId is unique.
  orderId         String   @unique
  /// Snapshot of trackingId for display.
  trackingId      String
  customerName    String
  /// Overall rating 1-5.
  rating          Int
  /// Optional sub-ratings 1-5 (null = not provided).
  freshnessRating Int?
  deliveryRating   Int?
  packingRating    Int?
  title           String?
  comment         String?
  /// Moderation status: pending | published | rejected
  status          String   @default("pending")
  /// Optional admin reply (shown alongside review when published).
  adminReply      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  /// Set when admin publishes. Null while pending/rejected.
  publishedAt     DateTime?

  @@index([status])
  @@index([publishedAt])
  @@index([rating])
}

// ============================================================
// Coupon — discount code system (customer-input codes).
// ============================================================
// Dual-layer with ERPNext Pricing Rule:
//   - Coupon (here): customer-input codes at checkout
//     (WELCOME10, ONGKIR0, HEMAT20). Validated + redeemed here.
//   - ERPNext Pricing Rule: automatic discounts per-item/customer
//     (synced into Product price). Not managed here.
//
// type: "percent" | "fixed" | "free_shipping"
//   percent       — value = 1..100 (percent off subtotal)
//   fixed         — value = IDR amount off subtotal
//   free_shipping — value ignored; sets shipping to 0
//
// scopeType: "all" | "category" | "product"
//   all       — applies to any order
//   category  — only when cart has items in scopeValue category
//   product   — only when cart has item with scopeValue itemCode
//
// Anti-abuse:
//   maxUsage     — total times coupon can be redeemed (0 = unlimited)
//   maxPerUser   — per-customer limit (identified by email or phone)
//   usedCount    — current redemption count (incremented atomically)
// ============================================================

model Coupon {
  id          String   @id @default(cuid())
  code        String   @unique
  /// "percent" | "fixed" | "free_shipping"
  type        String
  /// Percent (1-100) or IDR amount. Ignored for free_shipping.
  value       Int      @default(0)
  /// Minimum subtotal (IDR) for coupon to apply. 0 = no minimum.
  minOrder    Int      @default(0)
  /// Max total redemptions. 0 = unlimited.
  maxUsage    Int      @default(0)
  /// Max redemptions per customer (by email or phone). 0 = unlimited.
  maxPerUser  Int      @default(1)
  usedCount   Int      @default(0)
  startsAt    DateTime?
  expiresAt   DateTime?
  active      Boolean  @default(true)
  /// "all" | "category" | "product"
  scopeType   String   @default("all")
  /// Category name or itemCode (when scopeType != "all")
  scopeValue  String?
  /// Optional internal note (admin only)
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  usages      CouponUsage[]

  @@index([active])
  @@index([expiresAt])
}

/// CouponUsage — one row per redemption. Anti-abuse + audit.
/// Identified by email OR phone (guest checkout). userId null
/// for guest (no auth on storefront).
model CouponUsage {
  id        String   @id @default(cuid())
  couponId  String
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  /// Snapshot of coupon code for display even if coupon deleted.
  code      String
  orderId   String?
  /// Customer identifier (email or phone, whichever was provided)
  email     String?
  phone     String?
  userId    String?
  /// Discount amount applied (IDR, snapshot)
  discount  Int
  usedAt    DateTime @default(now())

  @@index([couponId])
  @@index([email])
  @@index([phone])
  @@index([orderId])
}

// ============================================================
// Payments — mock payment gateway (ready for Midtrans upgrade).
// ============================================================
// Payment: 1 per order. Status: pending → paid → failed.
// method: "cod" | "transfer" | "ewallet"
// vaNumber: Virtual Account number for transfer (mock: random)
// paymentUrl: payment link for e-wallet (mock)
// When upgraded to Midtrans: replace mock VA/URL with real API response.
// ============================================================

model Payment {
  id          String   @id @default(cuid())
  orderId     String   @unique
  trackingId  String   // snapshot for customer reference
  method      String   // "cod" | "transfer" | "ewallet"
  amount      Int      // in IDR
  status      String   @default("pending") // "pending" | "paid" | "failed"
  /// VA number for transfer (mock: random 12-digit)
  vaNumber    String?
  /// Bank name for VA
  vaBank      String?
  /// Payment URL for e-wallet (mock)
  paymentUrl  String?
  paidAt      DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([orderId])
  @@index([status])
  @@index([trackingId])
}

// ============================================================
// Products — admin-managed product catalog (DB-first, with ERPNext
// sync as a secondary source). Stored separately from ERPNext Item
// so admin can edit/publish/organize without affecting ERPNext.
// ============================================================
// itemCode: unique business key (maps to ERPNext item_code)
// variants: optional SKU-level variants (e.g. 250gr, 500gr, 1kg)
// published: visibility on public storefront (hidden = admin-only)
// order: manual ordering on storefront (asc)
// ============================================================

model Product {
  id              String   @id @default(cuid())
  /// Business key — unique. Maps to ERPNext item_code when synced.
  itemCode        String   @unique
  name            String
  description     String   @default("")
  /// Long-form description shown in detail modal (markdown/plain text).
  longDescription String?
  category        String   @default("Lainnya")
  /// Price in IDR
  price           Int      @default(0)
  /// Old price for discount display. Null = no discount shown.
  oldPrice        Int?
  unit            String   @default("pcs")
  stock           Int      @default(0)
  emoji           String   @default("🛒")
  /// Image URL (relative path like /products/tomat.png, or absolute URL)
  image           String?
  organic         Boolean  @default(false)
  onSale          Boolean  @default(false)
  /// JSON-encoded string array of tags: ["lokal","segar","organik"]
  tags            String?
  /// JSON-encoded string array of benefit bullet points
  benefits        String?
  storageTip      String?
  origin          String?
  published       Boolean  @default(true)
  order           Int      @default(0)
  /// Last ERPNext sync timestamp (null = never synced)
  erpSyncedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  variants        ProductVariant[]

  @@index([category])
  @@index([published])
  @@index([order])
}

/// Product variants — optional SKU-level child rows.
/// e.g. Product "Beras Organik" → variants 250gr, 500gr, 1kg.
model ProductVariant {
  id          String   @id @default(cuid())
  productId   String
  name        String
  price       Int      @default(0)
  oldPrice    Int?
  stock       Int      @default(0)
  unit        String   @default("pcs")
  /// SKU code (optional)
  sku         String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

// ============================================================
// Integration Config — stores ERPNext + other integration
// settings in DB (editable via admin UI, no env restart needed).
// ============================================================
// Keys: erpnext_url, erpnext_api_key, erpnext_api_secret,
//       erpnext_warehouse, erpnext_company, erpnext_site
// isSecret=true → value is encrypted (AES-256-CBC) before save
// ============================================================
model IntegrationConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  isSecret  Boolean  @default(false)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}