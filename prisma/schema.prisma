// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Messages submitted via the public contact form (Section Kontak).
/// Persisted for admin follow-up; safe to prune old entries periodically.
model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  /// Status of admin follow-up: pending | replied | archived
  status    String   @default("pending")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

/// Email subscribers from the footer newsletter signup form.
/// Unique email constraint prevents duplicates.
model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  /// Status: active | unsubscribed
  status    String   @default("active")
  /// Source of subscription: footer | promo | manual
  source    String   @default("footer")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

// ============================================================
// Admin-editable content models
// ============================================================
// SiteSetting: singleton row holding key-value content for Hero,
// Promo, Contact, About, Footer sections. Fallback to hardcoded
// defaults if row missing or field null (backward compat).
// ============================================================

/// Singleton row (id='singleton') holding editable site content.
/// All fields optional — null means use hardcoded default.
model SiteSetting {
  id    String  @id @default("singleton")

  // Hero section
  heroBadge        String? // "Dipetik pagi, sampai rumah siang"
  heroTitleA       String? // "Sayur & Buah"
  heroTitleHighlight String? // "Segar Harian"
  heroTitleB       String? // "dari Petani Lokal"
  heroSubtitle     String?
  heroCtaPrimary   String? // "Mulai Belanja"
  heroCtaSecondary String? // "Lihat Promo"

  // Promo banner
  promoId          String? // unique campaign id (changing resets dismiss)
  promoTitle       String?
  promoDescription String?

  // Contact section
  contactPhone     String?
  contactEmail     String?
  contactAddress   String?
  contactHours     String?

  // About section
  aboutBadge       String?
  aboutTitleA      String?
  aboutTitleHighlight String?
  aboutTitleB      String?
  aboutSubtitle    String?
  aboutStoryH3     String?
  aboutStoryP1     String?
  aboutStoryP2     String?
  aboutStat1Value  String?
  aboutStat1Label  String?
  aboutStat2Value  String?
  aboutStat2Label  String?
  aboutStat3Value  String?
  aboutStat3Label  String?
  aboutStat4Value  String?
  aboutStat4Label  String?
  aboutValue1Title String?
  aboutValue1Desc  String?
  aboutValue2Title String?
  aboutValue2Desc  String?
  aboutValue3Title String?
  aboutValue3Desc  String?
  aboutValue4Title String?
  aboutValue4Desc  String?

  // Footer
  footerBrandText  String?
  footerTagline    String?

  updatedAt DateTime @updatedAt
}

/// FAQ items — orderable, publishable.
model FAQ {
  id        String  @id @default(cuid())
  question  String
  answer    String
  order     Int     @default(0)
  published Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published])
  @@index([order])
}

/// Testimonials — orderable, publishable.
model Testimonial {
  id        String  @id @default(cuid())
  name      String
  role      String
  avatar    String  // emoji
  rating    Float   // 0-5
  text      String
  location  String
  order     Int     @default(0)
  published Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published])
  @@index([order])
}

/// Categories (Item Group display) — editable emoji, name, description.
/// Kept separate from ERPNext Item Group to allow custom display config.
model CategorySetting {
  id          String  @id @default(cuid())
  name        String  @unique // matches Product.category
  emoji       String
  description String?
  gradient    String  // tailwind gradient classes
  order       Int     @default(0)
  published   Boolean @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published])
  @@index([order])
}

// ============================================================
// Audit log — track all admin actions for accountability.
// ============================================================
// Sprint 6 (Skenario C): logs IP + timestamp + action (no user
// tracking since password gate is shared). When upgraded to NextAuth
// (Plan B), add userId field for user-specific tracking.
// ============================================================

/// Audit log entries for all admin API actions.
model AdminAuditLog {
  id        String   @id @default(cuid())
  /// Action type: "login_success" | "login_failed" | "create" | "update" | "delete" | "rate_limit_hit"
  action    String
  /// Target of action: "faq:abc123" | "content:hero" | "testimonial:xyz" | "login"
  target    String
  /// IP address of requester (for cross-referencing with karyawan)
  ip        String?
  /// User-Agent string (browser/device info)
  userAgent String?
  /// Whether action succeeded (false for failed login, etc.)
  success   Boolean  @default(true)
  /// Optional detail message (e.g., validation error)
  detail    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([action])
  @@index([ip])
}

// ============================================================
// Orders — customer orders for tracking + admin management.
// ============================================================
// Order: header record (1 per checkout). itemsJson: line items as
// JSON string (avoids separate table for simplicity).
// trackingId: customer-facing ID (6-char uppercase alphanumeric,
//   easy to share via WhatsApp).
// status: pending → confirmed → preparing → out_for_delivery →
//   delivered (or cancelled). Admin updates via dashboard.
// erpSalesOrderName: link to ERPNext Sales Order (null in mock mode).
// ============================================================

model Order {
  id              String   @id @default(cuid())
  /// Customer-facing tracking ID (6-char uppercase alphanumeric)
  trackingId      String   @unique
  /// Customer info (snapshot at order time)
  customerName    String
  customerEmail   String?
  customerPhone   String
  customerAddress String
  customerCity    String?
  customerNotes   String?
  /// Order details (JSON string of items array)
  itemsJson       String
  subtotal        Int      // in IDR
  shipping        Int      // in IDR
  total           Int      // in IDR
  deliveryMethod  String   // "delivery" | "pickup"
  paymentMethod   String   // "cod" | "transfer" | "ewallet"
  /// Status workflow: pending → confirmed → preparing →
  /// out_for_delivery → delivered | cancelled
  status          String   @default("pending")
  /// Link to ERPNext Sales Order (null in mock mode)
  erpSalesOrderName String?
  /// Estimated delivery time (ISO string)
  estimatedDelivery String?
  /// JSON array of {status, timestamp} for history tracking
  statusHistoryJson String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([trackingId])
  @@index([status])
  @@index([createdAt])
  @@index([customerPhone])
  @@index([customerEmail])
}

// ============================================================
// Payments — mock payment gateway (ready for Midtrans upgrade).
// ============================================================
// Payment: 1 per order. Status: pending → paid → failed.
// method: "cod" | "transfer" | "ewallet"
// vaNumber: Virtual Account number for transfer (mock: random)
// paymentUrl: payment link for e-wallet (mock)
// When upgraded to Midtrans: replace mock VA/URL with real API response.
// ============================================================

model Payment {
  id          String   @id @default(cuid())
  orderId     String   @unique
  trackingId  String   // snapshot for customer reference
  method      String   // "cod" | "transfer" | "ewallet"
  amount      Int      // in IDR
  status      String   @default("pending") // "pending" | "paid" | "failed"
  /// VA number for transfer (mock: random 12-digit)
  vaNumber    String?
  /// Bank name for VA
  vaBank      String?
  /// Payment URL for e-wallet (mock)
  paymentUrl  String?
  paidAt      DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([orderId])
  @@index([status])
  @@index([trackingId])
}